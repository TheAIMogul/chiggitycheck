{
  "name": "chiggitycheck",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "seed": "node scripts/build-seed.mjs && node scripts/render-sheets.mjs && node scripts/build-sql.mjs",
    "seed:sql": "node scripts/build-sql.mjs",
    "db:local": "wrangler d1 migrations apply chiggitycheck --local",
    "db:remote": "wrangler d1 migrations apply chiggitycheck --remote"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "hono": "^4.13.17",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "puppeteer-core": "^24.43.1",
    "qrcode": "^1.5.4",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.158.0"
  }
}
